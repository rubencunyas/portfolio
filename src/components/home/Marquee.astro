---
const rowA = ['UX/UI', 'Figma', 'Maquetación', 'Front-End', 'Astro', 'React', 'Design Systems'];
const rowB = ['WordPress', 'Elementor', 'Full Stack', 'Web Apps', 'Branding', 'SEO', 'Core Web Vitals'];
---

<section class="marquee overflow-hidden bg-accent-wine py-6 text-light" aria-hidden="true">
  <div class="marquee-track">
    {[...rowA, ...rowA].map((item) => (
      <span class="font-display text-2xl font-bold uppercase tracking-tight sm:text-4xl">
        {item}
        <span class="text-accent-orange">✦</span>
      </span>
    ))}
  </div>
  <div class="marquee-track reverse mt-4 text-light/70">
    {[...rowB, ...rowB].map((item) => (
      <span class="text-lg font-semibold sm:text-2xl">
        {item}
        <span class="text-accent-teal">✧</span>
      </span>
    ))}
  </div>
</section>
