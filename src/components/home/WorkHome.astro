---
import { getCollection } from 'astro:content';
import { getProjectImages } from '@/utils/images';

const projects = await getCollection('projects');
const selected = projects
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const cover = (slug: string, fallback?: string) => getProjectImages(slug).cover ?? fallback ?? '';

const modalData = selected.map((project) => ({
  slug: project.slug,
  title: project.data.title,
  client: project.data.client,
  year: project.data.year,
  category: project.data.category,
  tags: project.data.tags,
  technologies: project.data.technologies,
  challenge: project.data.challenge,
  solution: project.data.solution,
  result: project.data.result,
  url: project.data.url ?? '',
  cover: cover(project.slug, project.data.cover),
}));

const modalJson = JSON.stringify(modalData).replace(/</g, '\\u003c');
---

<section id="work" data-hwork class="relative bg-light text-ink">
  <div class="sticky top-0 flex h-[100svh] flex-col justify-center overflow-hidden py-24">
    <div class="mx-auto mb-8 w-full max-w-7xl px-[var(--home-gut)]">
      <div class="flex flex-col items-center gap-4 text-center">
        <p class="text-sm font-bold uppercase tracking-widest text-accent-wine">Trabajo seleccionado</p>
        <h2 class="font-display text-4xl font-bold uppercase leading-[.88] tracking-[-0.02em] sm:text-5xl lg:text-6xl">
          Diseño que <span class="text-accent-blue">mueve negocio.</span>
        </h2>
      </div>
    </div>

    <div id="hwork-track" class="hwork-track flex w-max gap-6 px-[var(--home-gut)]">
      {selected.map((project) => (
        <a
          href={`/projects/${project.slug}`}
          data-project={project.slug}
          aria-haspopup="dialog"
          class="group w-[74vw] flex-none sm:w-[46vw] lg:w-[360px]"
        >
          <div class="h-[min(46svh,440px)] overflow-hidden rounded-2xl bg-ink/5 shadow-lg shadow-ink/10">
            <img
              src={cover(project.slug, project.data.cover)}
              alt={project.data.title}
              width="840"
              height="1050"
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
            />
          </div>
          <div class="mt-4 flex items-start justify-between gap-4 border-b border-ink/15 pb-4">
            <div>
              <h3 class="font-display text-2xl font-bold uppercase tracking-tight transition-colors duration-300 group-hover:text-accent-wine">
                {project.data.title}
              </h3>
              <p class="mt-1 text-sm text-ink/60">{project.data.client} · {project.data.tags.slice(0, 2).join(' / ')}</p>
            </div>
            <span class="pt-1 text-2xl text-accent-wine transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">↗</span>
          </div>
        </a>
      ))}
    </div>

    <div class="mx-auto mt-8 w-full max-w-7xl px-[var(--home-gut)]">
      <div class="h-0.5 w-full overflow-hidden rounded-pill bg-ink/15">
        <i id="hwork-bar" class="hwork-bar block h-full w-full bg-accent-wine"></i>
      </div>
      <div class="mt-4 flex justify-center">
        <a href="/portfolio" class="inline-flex min-h-11 items-center rounded-pill border border-ink/20 px-5 text-xs font-bold uppercase tracking-wider transition-colors duration-300 hover:bg-ink hover:text-light">
          Ver todo el archivo <span class="ml-3" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

<script type="application/json" id="projects-data" set:html={modalJson}></script>

<dialog id="project-modal" class="pmodal" aria-labelledby="pm-title">
  <button type="button" id="pm-close" class="pm-close" aria-label="Cerrar proyecto">×</button>
  <div class="pm-media">
    <img id="pm-cover" src="" alt="" width="1200" height="675" />
    <span id="pm-badge" class="pm-badge"></span>
  </div>
  <div class="pm-body">
    <div class="pm-main">
      <p id="pm-meta" class="pm-meta"></p>
      <h3 id="pm-title" class="pm-title"></h3>
      <div class="pm-grid">
        <div class="pm-card">
          <h4>Reto</h4>
          <p id="pm-challenge"></p>
        </div>
        <div class="pm-card">
          <h4>Solución</h4>
          <p id="pm-solution"></p>
        </div>
        <div class="pm-card pm-card--wide">
          <h4>Resultado</h4>
          <p id="pm-result"></p>
        </div>
      </div>
    </div>
    <aside class="pm-side">
      <h4>Stack</h4>
      <div id="pm-tech" class="pm-tech"></div>
      <div class="pm-actions">
        <a id="pm-external" class="pm-btn pm-btn--solid" href="#" target="_blank" rel="noopener noreferrer">Ver proyecto en vivo</a>
        <a id="pm-internal" class="pm-btn pm-btn--line" href="#">Ver ficha completa</a>
      </div>
    </aside>
  </div>
</dialog>
