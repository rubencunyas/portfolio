  { symbol: 'Se', name: 'SEO', number: 33, family: 'concepts', used: ['Colegios Zárate', 'Organnical'] },
  { symbol: 'Cw', name: 'Core Web Vitals', number: 34, family: 'concepts', used: ['Colegios Zárate'] },
  { symbol: 'Ac', name: 'Accesibilidad', number: 35, family: 'concepts', used: ['Todos los proyectos'] },
  { symbol: 'Br', name: 'Branding', number: 36, family: 'concepts', used: ['Ay Mi Leche', 'Autoval'] },
];

const familyClass: Record<Family, string> = {
  languages: 'bg-accent-blue text-light',
  frontend: 'bg-accent-orange text-dark',
  backend: 'bg-accent-wine text-light',
  tools: 'bg-accent-teal text-dark',
  data: 'border border-ink/15 bg-light text-ink',
  concepts: 'bg-accent-teal-soft text-ink',
};
---

<section id="stack" class="overflow-hidden bg-accent-wine-soft px-[var(--home-gut)] py-24 text-ink lg:py-36">
  <div class="mx-auto max-w-7xl">
    <div class="scroll-animate max-w-3xl">
      <p class="text-sm font-bold uppercase tracking-widest text-accent-wine">Stack</p>
      <h2 data-split class="mt-5 font-display text-5xl font-bold uppercase leading-[.88] tracking-[-0.02em] sm:text-6xl lg:text-7xl">
        La tabla periódica de lo que construyo.
      </h2>
      <p class="mt-6 text-lg leading-relaxed text-ink/70">
        Los lenguajes, plataformas y herramientas con las que trabajo. Filtra por familia o pasa por encima para ver dónde los he usado.
      </p>
    </div>

    <div class="scroll-animate mt-8 flex flex-wrap gap-2" role="group" aria-label="Filtros de stack">
      <button type="button" class="pt-chip rounded-pill border border-ink/20 bg-light/60 px-4 py-2 text-sm font-semibold transition-colors" data-filter="all" aria-pressed="true">Todos</button>
      {families.map((family) => (
        <button type="button" class="pt-chip rounded-pill border border-ink/20 bg-light/60 px-4 py-2 text-sm font-semibold transition-colors" data-filter={family.id} aria-pressed="false">{family.label}</button>
      ))}
    </div>

    <div class="mt-8 grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_300px]">
      <div id="pt-grid" class="pt-grid grid grid-cols-4 gap-2 sm:grid-cols-6 lg:grid-cols-8">
        {elements.map((element) => (
          <button
            type="button"
            class:list={['pt-el', familyClass[element.family], 'flex aspect-square flex-col justify-between rounded-xl p-2 text-left transition-colors']}
            data-family={element.family}
            data-symbol={element.symbol}
            data-name={element.name}
            data-char={element.number}
            data-used={element.used.join('|')}
            style={`transition-delay:${(element.number % 8) * 45}ms`}
            aria-label={`${element.name}, familia ${element.family}`}
          >
            <small class="text-[10px] font-semibold opacity-75">{element.number}</small>
            <b class="font-display text-xl font-bold leading-none tracking-tight sm:text-2xl">{element.symbol}</b>
            <span class="truncate text-[10px] font-semibold">{element.name}</span>
          </button>
        ))}
      </div>

      <aside class="sticky top-24 rounded-2xl border border-ink/10 bg-light p-6 shadow-xl shadow-ink/10">
        <div id="pt-sym" class="mb-4 grid aspect-[1.4] place-items-center rounded-xl bg-accent-teal-soft font-display text-6xl font-bold tracking-tight text-ink">As</div>
        <h3 id="pt-name" class="font-display text-2xl font-bold uppercase tracking-tight">Astro</h3>
        <p id="pt-fam" class="mt-1 text-sm font-semibold text-ink/60">Front-end</p>
        <p class="mt-5 text-xs font-bold uppercase tracking-widest text-accent-wine">Dónde lo usé</p>
        <ul id="pt-used" class="mt-2 flex flex-wrap gap-2 text-sm font-semibold">
          <li class="rounded-pill bg-accent-teal-soft px-3 py-1">Colegios Zárate</li>
          <li class="rounded-pill bg-accent-teal-soft px-3 py-1">Organnical</li>
        </ul>
      </aside>
    </div>
  </div>
</section>
