---
type Family = 'languages' | 'frontend' | 'backend' | 'tools' | 'data' | 'concepts';

interface Element {
  symbol: string;
  name: string;
  number: number;
  family: Family;
  used: string[];
}

const families: { id: Family; label: string }[] = [
  { id: 'languages', label: 'Lenguajes' },
  { id: 'frontend', label: 'Front-end' },
  { id: 'backend', label: 'Back-end / Plataformas' },
  { id: 'tools', label: 'Herramientas' },
  { id: 'data', label: 'Datos' },
  { id: 'concepts', label: 'Conceptos' },
];

const elements: Element[] = [
  { symbol: 'Ht', name: 'HTML', number: 1, family: 'languages', used: ['Colegios Zárate', 'Berlitz', 'Organnical'] },
  { symbol: 'Cs', name: 'CSS', number: 2, family: 'languages', used: ['Berlitz', 'Autoval Service', 'Urpi'] },
  { symbol: 'Js', name: 'JavaScript', number: 3, family: 'languages', used: ['Organnical', 'MathPal', 'HM Tech'] },
  { symbol: 'Ts', name: 'TypeScript', number: 4, family: 'languages', used: ['Autoval Service', 'Urpi'] },
  { symbol: 'Ph', name: 'PHP', number: 5, family: 'languages', used: ['Colegios Zárate', 'WordPress'] },
  { symbol: 'Sl', name: 'SQL', number: 6, family: 'languages', used: ['Landing pages', 'Formularios'] },
  { symbol: 'As', name: 'Astro', number: 7, family: 'frontend', used: ['Colegios Zárate', 'Organnical'] },
  { symbol: 'Re', name: 'React', number: 8, family: 'frontend', used: ['MathPal', 'HM Tech'] },
  { symbol: 'Tw', name: 'Tailwind', number: 9, family: 'frontend', used: ['Este portfolio', 'Colegios Zárate'] },
  { symbol: 'Wp', name: 'WordPress', number: 10, family: 'frontend', used: ['Autoval Service', 'Urpi'] },
  { symbol: 'El', name: 'Elementor', number: 11, family: 'frontend', used: ['Autoval Service', 'Berlitz'] },
  { symbol: 'Fr', name: 'Framer', number: 12, family: 'frontend', used: ['Prototipos', 'Landing pages'] },
  { symbol: 'Sh', name: 'Shopify', number: 13, family: 'frontend', used: ['E-commerce', 'Autoval Branding'] },
  { symbol: 'Gs', name: 'GSAP', number: 14, family: 'frontend', used: ['Motion web', 'Campañas'] },
  { symbol: 'No', name: 'Node.js', number: 15, family: 'backend', used: ['Web apps', 'Automatizaciones'] },
  { symbol: 'Nf', name: 'Netlify', number: 16, family: 'backend', used: ['Deploy', 'Formularios'] },
  { symbol: 'Hb', name: 'HubSpot', number: 17, family: 'backend', used: ['Berlitz', 'Lead capture'] },
  { symbol: 'Fb', name: 'Firebase', number: 18, family: 'backend', used: ['Web apps', 'Auth'] },
  { symbol: 'Gt', name: 'Git', number: 19, family: 'tools', used: ['Todos los proyectos'] },
  { symbol: 'Gh', name: 'GitHub', number: 20, family: 'tools', used: ['Versionado', 'Deploy'] },
  { symbol: 'Vc', name: 'VS Code', number: 21, family: 'tools', used: ['Desarrollo diario'] },
  { symbol: 'Fg', name: 'Figma', number: 22, family: 'tools', used: ['Berlitz', 'MathPal'] },
  { symbol: 'Ps', name: 'Photoshop', number: 23, family: 'tools', used: ['Autoval', 'Catálogo Brother'] },
  { symbol: 'Ai', name: 'Illustrator', number: 24, family: 'tools', used: ['Identidades', 'Ilustración'] },
  { symbol: 'Ae', name: 'After Effects', number: 25, family: 'tools', used: ['Futura Schools', 'Autoval RRSS'] },
  { symbol: 'Pr', name: 'Premiere', number: 26, family: 'tools', used: ['Berlitz', 'Multimedia'] },
  { symbol: 'My', name: 'MySQL', number: 27, family: 'data', used: ['Colegios Zárate', 'Webs'] },
  { symbol: 'Pg', name: 'PostgreSQL', number: 28, family: 'data', used: ['Web apps'] },
  { symbol: 'Mg', name: 'MongoDB', number: 29, family: 'data', used: ['Prototipos de app'] },
  { symbol: 'Sb', name: 'Supabase', number: 30, family: 'data', used: ['Backends ligeros'] },
