---
const stats = [
  { value: 13, suffix: '+', label: 'Años construyendo proyectos web y digitales' },
  { value: 50, suffix: '+', label: 'Proyectos entregados para marcas y equipos' },
  { value: 1, suffix: '', label: 'Perfil: diseño y código en una sola cabeza' },
  { value: 2014, suffix: '', label: 'El año en que monté mi primer negocio', raw: true },
];
---

<section class="bg-accent-blue px-[var(--home-gut)] py-20 text-light lg:py-28">
  <div class="mx-auto grid max-w-7xl gap-y-12 sm:grid-cols-2 lg:grid-cols-4 lg:gap-x-10">
    {stats.map((stat) => (
      <div class="scroll-animate">
        <p class="font-display text-5xl font-bold leading-none tracking-[-0.03em] sm:text-6xl lg:text-7xl">
          <span class="stat-number" data-target={stat.value} data-raw={stat.raw ? 'true' : 'false'}>{stat.raw ? stat.value : 0}</span><span class="text-accent-orange">{stat.suffix}</span>
        </p>
        <p class="mt-4 max-w-[24ch] text-base leading-relaxed text-light/75">{stat.label}</p>
      </div>
    ))}
  </div>
</section>
