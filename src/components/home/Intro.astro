---
---

<section id="top" class="relative flex min-h-[100svh] flex-col overflow-hidden bg-accent-wine text-light">
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <span class="aurora-blob -left-[5%] top-[5%] h-[55vmax] w-[55vmax] bg-accent-orange/60"></span>
    <span class="aurora-blob right-0 top-[10%] h-[50vmax] w-[50vmax] bg-accent-blue/60"></span>
    <span class="aurora-blob -bottom-[10%] left-[25%] h-[45vmax] w-[45vmax] bg-sand/50"></span>
  </div>

  <div class="relative z-10 mx-auto grid w-full max-w-7xl flex-1 items-center gap-14 px-[var(--home-gut)] pb-24 pt-32 lg:grid-cols-[1.05fr_.95fr]">
    <h1 class="home-words font-display text-[3.25rem] font-bold uppercase leading-[.86] tracking-[-0.03em] sm:text-7xl lg:text-8xl xl:text-9xl">
      <span><i>Diseñador</i></span>
      <span><i>Front-End</i></span>
      <span><i>UX/UI</i></span>
      <span><i class="text-accent-orange">+ Producto</i></span>
    </h1>

    <div class="home-rig w-[min(72vw,330px)] justify-self-center lg:justify-self-end">
      <div class="mx-auto h-24 w-6 bg-accent-teal" aria-hidden="true"></div>
      <div
        id="home-card"
        class="home-card relative aspect-[.71] w-full select-none"
        role="button"
        tabindex="0"
        aria-label="Tarjeta de presentación de Rubén Cunyas. Toca para girarla."
      >
        <div class="face front overflow-hidden rounded-2xl border border-light/25 bg-light text-ink shadow-2xl shadow-ink/40">
          <div class="flex h-[56%] items-center justify-center bg-accent-teal font-display text-[5.5rem] font-bold leading-none tracking-[-0.05em] text-dark/90">RC</div>
          <div class="flex h-[44%] flex-col justify-center gap-3 px-5">
            <p class="font-display text-4xl font-bold uppercase leading-none tracking-tight">Rubén</p>
            <p class="text-sm font-semibold leading-snug text-ink/75">Diseñador Digital<br />+ Desarrollador Web</p>
            <span class="inline-flex w-fit items-center gap-2 rounded-pill bg-accent-wine/10 px-3 py-1.5 text-[10px] font-bold uppercase tracking-widest text-accent-wine">
              <span class="h-2 w-2 rounded-full bg-accent-teal" aria-hidden="true"></span>
              Disponible para proyectos
            </span>
          </div>
        </div>

        <div class="face back overflow-hidden rounded-2xl border border-ink/10 bg-accent-teal-soft p-6 text-ink shadow-2xl shadow-ink/40">
          <h3 class="font-display text-2xl font-bold uppercase tracking-tight">Qué hago</h3>
          <div class="mt-5 space-y-3">
            <div class="flex items-center gap-3 rounded-xl bg-light/70 p-3">
              <span class="grid h-10 w-10 flex-none place-items-center rounded-lg bg-accent-blue text-light" aria-hidden="true">✏</span>
              <div class="leading-tight">
                <p class="font-bold">Diseño</p>
                <p class="text-xs text-ink/65">UX/UI, prototipos, Figma</p>
              </div>
            </div>
            <div class="flex items-center gap-3 rounded-xl bg-light/70 p-3">
              <span class="grid h-10 w-10 flex-none place-items-center rounded-lg bg-accent-teal text-dark" aria-hidden="true">&lt;/&gt;</span>
              <div class="leading-tight">
                <p class="font-bold">Código</p>
                <p class="text-xs text-ink/65">Maquetación y front-end</p>
              </div>
            </div>
            <div class="flex items-center gap-3 rounded-xl bg-light/70 p-3">
              <span class="grid h-10 w-10 flex-none place-items-center rounded-lg bg-accent-orange text-dark" aria-hidden="true">◆</span>
              <div class="leading-tight">
                <p class="font-bold">Negocio</p>
                <p class="text-xs text-ink/65">Webs que captan clientes</p>
              </div>
            </div>
          </div>
          <p class="mt-5 border-t border-ink/15 pt-3 text-sm font-semibold text-accent-wine">Entender el problema, luego construirlo</p>
        </div>
      </div>
    </div>
  </div>

  <div class="relative z-10 mx-auto flex w-full max-w-7xl items-center justify-between gap-4 px-[var(--home-gut)] pb-6 text-sm text-light/70">
    <span aria-live="polite">
      <span id="home-typer"></span><span class="type-caret" aria-hidden="true"></span>
    </span>
    <span class="scroll-cue flex items-center gap-2">
      Desliza
      <b class="inline-block" aria-hidden="true"></b>
    </span>
  </div>
</section>
