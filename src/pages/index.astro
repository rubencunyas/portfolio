---
import Layout from '../layouts/Layout.astro';
import HomeNav from '../components/home/HomeNav.astro';
import Intro from '../components/home/Intro.astro';
import Marquee from '../components/home/Marquee.astro';
import AboutMe from '../components/home/AboutMe.astro';
import ServicesHome from '../components/home/ServicesHome.astro';
import Stats from '../components/home/Stats.astro';
import WorkHome from '../components/home/WorkHome.astro';
import Stack from '../components/home/Stack.astro';
import ContactHome from '../components/home/ContactHome.astro';
---

<Layout
  title="Rubén Cunyas · Diseñador Digital y Desarrollador Web"
  description="Diseño y desarrollo webs que captan clientes: UX/UI, identidad visual y front-end. Portfolio de Rubén Cunyas."
  imageAlt="Rubén Cunyas — Diseñador digital y desarrollador web"
  keywords="Rubén Cunyas, diseñador digital, desarrollador web, UX/UI, front-end, landing pages, Astro, WordPress, portfolio"
>
  <HomeNav />
  <main id="main-content">
    <Intro />
    <Marquee />
    <AboutMe />
    <ServicesHome />
    <Stats />
    <WorkHome />
    <Stack />
    <ContactHome />
  </main>
</Layout>

<script>
  import '../scripts/home.js';
</script>
