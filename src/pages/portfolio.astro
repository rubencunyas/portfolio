---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getProjectImages } from '@/utils/images';

const projects = await getCollection('projects');
const categoryPriority: Record<string, number> = { uxui: 0, web: 1, branding: 2, multimedia: 3 };
const sorted = [...projects].sort((a, b) => {
  const aP = categoryPriority[a.data.category] ?? 9;
  const bP = categoryPriority[b.data.category] ?? 9;
  if (aP !== bP) return aP - bP;
  if (b.data.year !== a.data.year) return b.data.year - a.data.year;
  return (a.data.order ?? 0) - (b.data.order ?? 0);
});

const activeCategories = new Set(sorted.map((project) => project.data.category));
const has360 = sorted.some((project) => project.data.full360);
const categories = [
  { id: 'all', label: 'Todos' },
  ...(has360 ? [{ id: '360', label: '360°' }] : []),
  ...[
    { id: 'branding', label: 'Branding' },
    { id: 'uxui', label: 'UX/UI' },
    { id: 'web', label: 'Desarrollo Web' },
    { id: 'multimedia', label: 'Multimedia' },
  ].filter((cat) => activeCategories.has(cat.id)),
];

function staggerClass(index: number): string {
  const classes: string[] = [];
  if (index % 2 === 1) classes.push('md:mt-20');
  if (index % 3 === 1) classes.push('lg:mt-24');
  else if (index % 3 === 2) classes.push('lg:mt-12');
  return classes.join(' ');
}
---

<Layout
  title="Portfolio | Rubén Cunyas"
  description="Todos los proyectos de diseño digital, branding y desarrollo web."
  imageAlt="Portfolio de proyectos de diseño digital, branding y desarrollo web de Rubén Cunyas"
  keywords="portfolio diseño digital, proyectos branding, desarrollo web, diseño UX/UI, Rubén Cunyas"
>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "Portfolio de proyectos digitales",
      "description": "Todos los proyectos de diseño digital, branding y desarrollo web.",
      "url": "https://portfolio-rub.netlify.app/portfolio/",
      "about": {
        "@type": "Thing",
        "name": "Proyectos de diseño y desarrollo digital"
      }
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Portfolio", "item": "https://portfolio-rub.netlify.app/" },
        { "@type": "ListItem", "position": 2, "name": "Proyectos", "item": "https://portfolio-rub.netlify.app/portfolio/" }
      ]
    }
  </script>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Proyectos de diseño digital y desarrollo web",
    "numberOfItems": sorted.length,
    "itemListElement": sorted.map((project, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "name": project.data.title,
      "url": `https://portfolio-rub.netlify.app/projects/${project.slug}`
    }))
  })} />

  <main id="main-content" class="min-h-screen bg-light text-ink">
    <section class="pt-10 lg:pt-16 pb-12 lg:pb-16 px-6 lg:px-12">
      <div class="max-w-7xl mx-auto">
        <header class="scroll-animate">
          <h1 class="font-display font-bold text-5xl sm:text-7xl lg:text-8xl tracking-tight leading-none mb-6 flex items-center gap-4">
            <img src="/logo.svg" alt="Rubén Cunyas" width="48" height="48" class="w-10 h-10 sm:w-12 sm:h-12" />
            PORTAFOLIO.
          </h1>
          <p class="text-lg sm:text-xl text-ink/60 max-w-xl">
            Cada proyecto busca conectar la información de forma humana y clara.
          </p>
        </header>
      </div>
    </section>

    <section class="bg-ink text-light px-6 lg:px-12 py-14 lg:py-20">
      <div class="max-w-7xl mx-auto">
        <div class="scroll-animate flex items-center gap-4 mb-10">
          <span class="text-xs font-bold uppercase tracking-widest text-light/50">Proyectos</span>
          <span class="line-reveal h-px flex-1 bg-light/10"></span>
        </div>

        <div class="flex flex-wrap gap-2 lg:gap-3 mb-12 lg:mb-16" id="project-filters">
          {categories.map((cat) => (
            <a
              href={`/portfolio/${cat.id === 'all' ? '' : `?cat=${cat.id}`}`}
              data-filter={cat.id}
              aria-pressed={cat.id === 'all' ? 'true' : 'false'}
              class={`filter-btn shrink-0 px-3 lg:px-5 py-1.5 lg:py-2 text-xs lg:text-sm font-medium uppercase tracking-wider transition-all duration-300 active:scale-95 ${
                cat.id === 'all'
                  ? 'bg-light text-ink'
                  : 'bg-transparent text-light/60 border border-light/20 hover:border-light/50 hover:text-light'
              }`}
            >
              {cat.label}
            </a>
          ))}
        </div>

        <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-16 items-start">
          {sorted.map((project, index) => (
            <a
              href={`/projects/${project.slug}`}
              data-category={project.data.category}
              data-full360={project.data.full360 ? 'true' : 'false'}
              class={`project-card group block scroll-animate ${staggerClass(index)}`}
            >
              <div class="relative aspect-[4/3] overflow-hidden bg-light/[0.04] ring-1 ring-inset ring-light/5">
                <img
                  src={getProjectImages(project.slug).cover ?? project.data.cover}
                  alt={project.data.title}
                  width="1000"
                  height="750"
                  loading="lazy"
                  class="h-full w-full object-cover transition duration-500 ease-out group-hover:scale-[1.03]"
                />
                <span class="absolute left-4 top-4 bg-light px-3 py-2 text-xs font-bold uppercase tracking-widest text-ink">
                  {project.data.year}
                </span>
                <div class="absolute right-4 top-4 flex flex-col items-end gap-1.5">
                  {project.data.full360 && (
                    <span class="px-2.5 py-1.5 text-[10px] font-bold uppercase tracking-widest bg-accent-blue text-light">
                      360°
                    </span>
                  )}
                  {project.data.ai_tools?.length ? (
                    <span class="px-2.5 py-1.5 text-[10px] font-bold uppercase tracking-widest bg-accent-orange text-light">
                      IA
                    </span>
                  ) : null}
                </div>
              </div>
              <div class="mt-4 flex items-start justify-between gap-4 border-b border-light/10 pb-4">
                <div>
                  <h3 class="font-display text-2xl font-bold uppercase leading-tight tracking-[-0.01em] transition-colors duration-300 ease-out group-hover:text-accent-orange sm:text-3xl">
                    {project.data.title}
                  </h3>
                  <p class="mt-1 text-sm text-light/55">
                    {project.data.client} · {project.data.tags.slice(0, 2).join(' / ')}
                  </p>
                </div>
                <span class="pt-1 text-2xl text-accent-blue transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">↗</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  function getActiveFilter() {
    const params = new URLSearchParams(window.location.search);
    return params.get('cat') || 'all';
  }

  function setActiveFilter(filter) {
    const buttons = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.project-card');

    buttons.forEach(b => {
      const isActive = b.dataset.filter === filter;
      b.setAttribute('aria-pressed', String(isActive));
      if (isActive) {
        b.classList.add('bg-light', 'text-ink');
        b.classList.remove('bg-transparent', 'text-light/60', 'border', 'border-light/20');
      } else {
        b.classList.remove('bg-light', 'text-ink');
        b.classList.add('bg-transparent', 'text-light/60', 'border', 'border-light/20');
      }
    });

    const visible = [];

    cards.forEach(card => {
      const show = filter === 'all'
        || (filter === '360' ? card.dataset.full360 === 'true' : card.dataset.category === filter);
      if (show) {
        card.style.display = 'block';
        if (card.dataset.hidden === 'true') {
          card.classList.add('visible');
          card.dataset.hidden = 'false';
        }
        visible.push(card);
      } else {
        card.style.display = 'none';
        card.dataset.hidden = 'true';
      }
    });

    const OFFSET_CLASSES = ['md:mt-20', 'lg:mt-24', 'lg:mt-12'];
    visible.forEach((card, i) => {
      card.classList.remove(...OFFSET_CLASSES);
      if (i % 2 === 1) card.classList.add('md:mt-20');
      if (i % 3 === 1) card.classList.add('lg:mt-24');
      else if (i % 3 === 2) card.classList.add('lg:mt-12');
    });
  }

  function initFilters() {
    const buttons = document.querySelectorAll('.filter-btn');

    buttons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const filter = btn.dataset.filter;
        const url = filter === 'all' ? '/portfolio/' : `/portfolio/?cat=${filter}`;
        history.pushState({ filter }, '', url);
        setActiveFilter(filter);
      });
    });

    window.addEventListener('popstate', (e) => {
      setActiveFilter(e.state?.filter || getActiveFilter());
    });

    setActiveFilter(getActiveFilter());
  }

  initFilters();
  document.addEventListener('astro:after-swap', initFilters);
</script>
