---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const categoryPriority: Record<string, number> = { branding: 0, multimedia: 1, uxui: 2, web: 3 };
const sorted = [...projects].sort((a, b) => {
  const aP = categoryPriority[a.data.category] ?? 9;
  const bP = categoryPriority[b.data.category] ?? 9;
  if (aP !== bP) return aP - bP;
  if (b.data.year !== a.data.year) return b.data.year - a.data.year;
  return (a.data.order ?? 0) - (b.data.order ?? 0);
});

const activeCategories = new Set(sorted.map((project) => project.data.category));
const has360 = sorted.some((project) => project.data.full360);
const hasWeb = sorted.some((project) => project.data.category === 'web' || project.data.web);
const categories = [
  { id: 'all', label: 'Todos' },
  ...(has360 ? [{ id: '360', label: '360°' }] : []),
  ...[
    { id: 'branding', label: 'Branding' },
    { id: 'multimedia', label: 'Multimedia' },
    { id: 'uxui', label: 'UX/UI' },
    { id: 'web', label: 'Desarrollo Web' },
  ].filter((cat) => activeCategories.has(cat.id) || (cat.id === 'web' && hasWeb)),
];

const stage360Priority: Record<string, number> = { branding: 0, uxui: 1, web: 2, multimedia: 3 };
const groups360Map = new Map<string, typeof sorted>();
for (const project of sorted) {
  if (!project.data.full360) continue;
  const key = project.data.group360 || project.data.client;
  const list = groups360Map.get(key) ?? [];
  list.push(project);
  groups360Map.set(key, list);
}
const groups360 = [...groups360Map.entries()].map(([name, items]) => ({
  name,
  projects: [...items].sort((a, b) => {
    const ap = stage360Priority[a.data.category] ?? 9;
    const bp = stage360Priority[b.data.category] ?? 9;
    if (ap !== bp) return ap - bp;
    return (a.data.order ?? 0) - (b.data.order ?? 0);
  }),
}));

const validFilters = new Set(categories.map((cat) => cat.id));
const requestedFilter = Astro.url.searchParams.get('cat') || 'all';
const initialFilter = validFilters.has(requestedFilter) ? requestedFilter : 'all';
---

<Layout
  title="Portfolio | Rubén Cunyas"
  description="Todos los proyectos de diseño digital, branding y desarrollo web."
  imageAlt="Portfolio de proyectos de diseño digital, branding y desarrollo web de Rubén Cunyas"
  keywords="portfolio diseño digital, proyectos branding, desarrollo web, diseño UX/UI, Rubén Cunyas"
>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": "Portfolio de proyectos digitales",
      "description": "Todos los proyectos de diseño digital, branding y desarrollo web.",
      "url": "https://portfolio-rub.netlify.app/portfolio/",
      "about": {
        "@type": "Thing",
        "name": "Proyectos de diseño y desarrollo digital"
      }
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Portfolio", "item": "https://portfolio-rub.netlify.app/" },
        { "@type": "ListItem", "position": 2, "name": "Proyectos", "item": "https://portfolio-rub.netlify.app/portfolio/" }
      ]
    }
  </script>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "name": "Proyectos de diseño digital y desarrollo web",
    "numberOfItems": sorted.length,
    "itemListElement": sorted.map((project, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "name": project.data.title,
      "url": `https://portfolio-rub.netlify.app/projects/${project.slug}`
    }))
  })} />

  <main id="main-content" class="min-h-screen bg-light text-ink">
    <section class="pt-10 lg:pt-16 pb-12 lg:pb-16 px-6 lg:px-12">
      <div class="max-w-7xl mx-auto">
        <header class="scroll-animate">
          <h1 class="font-display font-bold text-5xl sm:text-7xl lg:text-8xl tracking-tight leading-none mb-6 flex items-center gap-4">
            <img src="/logo.svg" alt="Rubén Cunyas" width="48" height="48" class="w-10 h-10 sm:w-12 sm:h-12" />
            PORTAFOLIO.
          </h1>
          <p class="text-lg sm:text-xl text-ink/60 max-w-xl">
            Cada proyecto busca conectar la información de forma humana y clara.
          </p>
        </header>
      </div>
    </section>

    <section class="bg-ink text-light px-6 lg:px-12 py-14 lg:py-20">
      <div class="max-w-7xl mx-auto">
        <div class="scroll-animate flex items-center gap-4 mb-10">
          <span class="text-xs font-bold uppercase tracking-widest text-light/50">Proyectos</span>
          <span class="line-reveal h-px flex-1 bg-light/10"></span>
        </div>

        <h2 class="sr-only">Proyectos</h2>

        <div class="flex flex-wrap gap-2 lg:gap-3 mb-12 lg:mb-16" id="project-filters" role="group" aria-label="Filtrar proyectos por categoría">
          {categories.map((cat) => {
            const isActive = cat.id === initialFilter;
            return (
              <a
                href={`/portfolio/${cat.id === 'all' ? '' : `?cat=${cat.id}`}`}
                data-filter={cat.id}
                aria-current={isActive ? 'true' : undefined}
                class={`filter-btn inline-flex min-h-[40px] shrink-0 items-center px-3 lg:px-5 py-2.5 lg:py-2 text-xs lg:text-sm font-medium uppercase tracking-wider transition-all duration-300 active:scale-95 ${
                  isActive
                    ? 'bg-light text-ink'
                    : 'bg-transparent text-light/60 border border-light/20 hover:border-light/50 hover:text-light'
                }`}
              >
                {cat.label}
              </a>
            );
          })}
        </div>

        <p id="projects-status" class="sr-only" aria-live="polite"></p>

        <p id="projects-empty" hidden class="py-16 text-sm text-light/60">
          No hay proyectos en esta categoría.
          <a href="/portfolio/" class="underline underline-offset-4 hover:text-light">Ver todos</a>
        </p>

        <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-16 items-start">
          {sorted.map((project, index) => (
            <ProjectCard project={project} index={index} />
          ))}
        </div>

        <div id="projects-360" style="display: none;">
          {groups360.map((group) => (
            <div class="mb-16 lg:mb-24 last:mb-0">
              <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 border-b border-light/10 pb-4 mb-10">
                <h2 class="font-display text-3xl sm:text-4xl font-bold uppercase tracking-tight">
                  {group.name}
                </h2>
                <span class="text-[10px] font-bold uppercase tracking-widest text-accent-orange">
                  Proyecto 360°
                </span>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-16 items-start">
                {group.projects.map((project, index) => (
                  <ProjectCard project={project} index={index} show360Badge={false} />
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  function getActiveFilter() {
    const params = new URLSearchParams(window.location.search);
    return params.get('cat') || 'all';
  }

  function setActiveFilter(filter) {
    const buttons = document.querySelectorAll('.filter-btn');
    const grid = document.getElementById('projects-grid');
    const grouped = document.getElementById('projects-360');
    const empty = document.getElementById('projects-empty');
    const status = document.getElementById('projects-status');

    buttons.forEach(b => {
      const isActive = b.dataset.filter === filter;
      if (isActive) {
        b.setAttribute('aria-current', 'true');
        b.classList.add('bg-light', 'text-ink');
        b.classList.remove('bg-transparent', 'text-light/60', 'border', 'border-light/20');
      } else {
        b.removeAttribute('aria-current');
        b.classList.remove('bg-light', 'text-ink');
        b.classList.add('bg-transparent', 'text-light/60', 'border', 'border-light/20');
      }
    });

    if (!grid) return;

    if (empty) empty.hidden = true;

    const hasGroups = grouped && grouped.querySelector('.project-card');

    if (filter === '360' && hasGroups) {
      grid.style.display = 'none';
      grouped.style.display = 'block';
      grouped.querySelectorAll('.scroll-animate').forEach(el => el.classList.add('visible'));
      if (status) status.textContent = 'Mostrando proyectos agrupados 360°.';
      return;
    }

    grid.style.display = '';
    if (grouped) grouped.style.display = 'none';

    const visible = [];
    const cards = grid.querySelectorAll('.project-card');

    cards.forEach(card => {
      const show = filter === 'all'
        || (filter === 'web'
          ? (card.dataset.category === 'web' || card.dataset.web === 'true')
          : card.dataset.category === filter);
      if (show) {
        card.style.display = 'block';
        if (card.dataset.hidden === 'true') {
          card.classList.add('visible');
          card.dataset.hidden = 'false';
        }
        visible.push(card);
      } else {
        card.style.display = 'none';
        card.dataset.hidden = 'true';
      }
    });

    const OFFSET_CLASSES = ['md:mt-20', 'lg:mt-24', 'lg:mt-12'];
    visible.forEach((card, i) => {
      card.classList.remove(...OFFSET_CLASSES);
      if (i % 2 === 1) card.classList.add('md:mt-20');
      if (i % 3 === 1) card.classList.add('lg:mt-24');
      else if (i % 3 === 2) card.classList.add('lg:mt-12');
    });

    if (visible.length === 0) {
      grid.style.display = 'none';
      if (empty) empty.hidden = false;
      if (status) status.textContent = 'No hay proyectos en esta categoría.';
    } else if (status) {
      status.textContent = `${visible.length} ${visible.length === 1 ? 'proyecto mostrado' : 'proyectos mostrados'}.`;
    }
  }

  let filtersBound = false;
  function initFilters() {
    const buttons = document.querySelectorAll('.filter-btn');

    buttons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
        e.preventDefault();
        const filter = btn.dataset.filter;
        if (filter === getActiveFilter()) return;
        const url = filter === 'all' ? '/portfolio/' : `/portfolio/?cat=${filter}`;
        history.pushState({ filter }, '', url);
        setActiveFilter(filter);
      });
    });

    if (!filtersBound) {
      filtersBound = true;
      window.addEventListener('popstate', (e) => {
        setActiveFilter(e.state?.filter || getActiveFilter());
      });
    }

    setActiveFilter(getActiveFilter());
  }

  initFilters();
  document.addEventListener('astro:after-swap', initFilters);
</script>
